    {
      "id": "text-110",
      "type": "text",
      "x": 400,
      "y": 1250,
      "width": 780,
      "height": 15.0,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "No path ends silently: SUPPRESSED, ABORTED, NO_ACTION (x2), DEADLOCKED, WITHDRAWN, REJECTED, EXPIRED, EXECUTED, EXECUTION_FAILED are all durably recorded, which is what makes deadlock rate and quorum-failure rate measurable (page 08 names deadlock rate as a health metric without the state to produce it). Illegal transitions and guards in full: review/R07_State_Machines.md \u00a73.",
      "fontSize": 12,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No path ends silently: SUPPRESSED, ABORTED, NO_ACTION (x2), DEADLOCKED, WITHDRAWN, REJECTED, EXPIRED, EXECUTED, EXECUTION_FAILED are all durably recorded, which is what makes deadlock rate and quorum-failure rate measurable (page 08 names deadlock rate as a health metric without the state to produce it). Illegal transitions and guards in full: review/R07_State_Machines.md \u00a73.",
      "lineHeight": 1.25
    }
