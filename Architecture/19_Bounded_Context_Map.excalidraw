      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Solid arrow = main data-flow chain\nDashed arrow = published read model\n(never a live dependency on internals)\n\nBC12 and BC5 both read; neither is\never read BACK by BC6 or BC8 \u2014 the\nacyclic property ADR-0012 established\nand ADR-0043 preserves.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Solid arrow = main data-flow chain\nDashed arrow = published read model\n(never a live dependency on internals)\n\nBC12 and BC5 both read; neither is\never read BACK by BC6 or BC8 \u2014 the\nacyclic property ADR-0012 established\nand ADR-0043 preserves.",
      "lineHeight": 1.25
    }
