      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Every Decision carries an\nunbroken chain back to the\nraw Feature Store inputs\nthat produced it:\n\nDecision\n  <- Committee reasoning\n  <- Desk citations\n  <- Quant Model outputs\n  <- Feature Store values\n  <- Validated bars\n\nThis chain is what the\nExplanation stage renders,\nand what an operator or\nauditor can walk backward\nthrough after the fact.",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every Decision carries an\nunbroken chain back to the\nraw Feature Store inputs\nthat produced it:\n\nDecision\n  <- Committee reasoning\n  <- Desk citations\n  <- Quant Model outputs\n  <- Feature Store values\n  <- Validated bars\n\nThis chain is what the\nExplanation stage renders,\nand what an operator or\nauditor can walk backward\nthrough after the fact.",
      "lineHeight": 1.25
    }
