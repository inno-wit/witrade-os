    },
    {
      "id": "text-44",
      "type": "text",
      "x": 974,
      "y": 135,
      "width": 252,
      "height": 426.25,
      "angle": 0,
      "strokeColor": "#495057",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Every desk implements the\nsame interface:\n\nINPUTS\n  Deterministic API outputs\n  from its assigned engine only\n\nMEMORY\n  Last N committee cycles for\n  this symbol (continuity)\n\nTOOLS\n  Read-only queries into its\n  engine's API -- no write access,\n  no cross-desk calls\n\nOUTPUT JSON\n  { stance, confidence,\n    key_evidence[], reasoning }\n\nCONFIDENCE\n  0-100, discounted if inputs\n  carry a staleness/flag tag\n\nREASONING\n  Human-readable, cites only\n  numbers present in its own\n  Inputs (schema-validated --\n  a desk cannot cite a figure\n  the Quant layer never\n  produced)",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every desk implements the\nsame interface:\n\nINPUTS\n  Deterministic API outputs\n  from its assigned engine only\n\nMEMORY\n  Last N committee cycles for\n  this symbol (continuity)\n\nTOOLS\n  Read-only queries into its\n  engine's API -- no write access,\n  no cross-desk calls\n\nOUTPUT JSON\n  { stance, confidence,\n    key_evidence[], reasoning }\n\nCONFIDENCE\n  0-100, discounted if inputs\n  carry a staleness/flag tag\n\nREASONING\n  Human-readable, cites only\n  numbers present in its own\n  Inputs (schema-validated --\n  a desk cannot cite a figure\n  the Quant layer never\n  produced)",
      "lineHeight": 1.25
    }
